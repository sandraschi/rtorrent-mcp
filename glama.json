{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": ["sandraschi"],
  "name": "rtorrent-mcp",
  "version": "3.0.0",
  "description": "FastMCP 3.4 MCP server for rTorrent automation with Austrian legal compliance. 6 consolidated portmanteau tools (torrent, search, nlp, legal, system, workflow) plus agentic workflow, skills, prompts, and sampling.",
  "type": "mcp_server",
  "status": "stable",
  "framework": "FastMCP 3.4.4",
  "tools": 7,
  "transport": ["stdio", "http"],
  "keywords": [
    "rtorrent",
    "torrent",
    "anime",
    "torrenting",
    "scgi",
    "mcp-server",
    "fastmcp",
    "legal-compliance"
  ],
  "features": {
    "rtorrent_integration": {
      "enabled": true,
      "api": "XML-RPC (/RPC2)"
    },
    "multi_source_search": {
      "enabled": true,
      "sources": ["nyaa.si", "Pirate Bay", "YTS", "Anna's Archive"]
    },
    "post_processing": {
      "enabled": true,
      "features": ["completion_detection", "filename_normalization", "plex_integration"]
    },
    "legal_compliance": {
      "enabled": true,
      "region": "Austria"
    },
    "sampling": {
      "enabled": true,
      "provider": "OpenAI-compatible (default Ollama)"
    }
  }
}
