# ===================================
# qBTMCP Configuration (FastMCP 2.10)
# ===================================

# ============
# Application
# ===========
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ============
# qBittorrent
# ===========
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# ============
# Nyaa.si
# ===========
NYAA_BASE_URL=https://nyaa.si

# ===================
# Content Management
# ===================
# Comma-separated list of allowed categories
ALLOWED_CATEGORIES=Anime

# Allowed video resolutions (comma-separated)
ALLOWED_RESOLUTIONS=720p,1080p

# Maximum allowed torrent size in GB
MAX_TORRENT_SIZE_GB=10

# Preferred release group (for sorting)
PREFERRED_RELEASE_GROUP=ASW

# ===================
# Legal & Compliance
# ===================
# Enable/disable legal compliance checks
ENABLE_LEGAL_CHECKS=true

# Default country for legal checks
DEFAULT_COUNTRY=AT  # Austria

# ===================
# Performance
# ===================
# Maximum concurrent downloads
MAX_CONCURRENT_DOWNLOADS=3

# Connection timeout in seconds
CONNECTION_TIMEOUT=30

# ===================
# Advanced
# ===================
# Path to custom config file (if not using .env)
# CONFIG_FILE=/path/to/config.env
