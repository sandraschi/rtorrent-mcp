# rtorrent-mcp — copy to .env and adjust
# XML-RPC must match docker-compose.yml host ports (default 12224 -> container nginx 8000).

# ============
# rTorrent (Docker: crazymax/rtorrent-rutorrent)
# ============
# Must match: docker compose maps "12224:8000" for nginx XML-RPC
RTORRENT_HOST=127.0.0.1
RTORRENT_PORT=12224

# ============
# Application
# ============
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ============
# Nyaa.si
# ============
NYAA_BASE_URL=https://nyaa.si

# ============
# Content / legal (optional)
# ============
ALLOWED_CATEGORIES=Anime
ALLOWED_RESOLUTIONS=720p,1080p
MAX_TORRENT_SIZE_GB=10

# ============
# FastMCP 3.1 sampling (optional)
# ============
# RTORRENT_SAMPLING_BASE_URL=http://127.0.0.1:11434/v1
# RTORRENT_SAMPLING_MODEL=llama3.2

# ============
# REST API (webapp /api/*) 
# ============
API_KEY=

# ============
# LLM chat (webapp /api/ai/chat + sampling)
# ============
# RTORRENT_SAMPLING_BASE_URL=http://127.0.0.1:11434/v1
# RTORRENT_SAMPLING_MODEL=llama3.2
# RTORRENT_SAMPLING_USE_CLIENT_LLM=0

# ============
# Anna's Archive (ebooks / papers)
# ============
# Mirror seed + failover list. Defaults to annas-archive.is (the current live,
# non-Cloudflare-gated mirror). annas-archive.org no longer resolves; .li and
# .gl are anti-bot gated. Override if a mirror rotates.
# ANNAS_ARCHIVE_BASE=https://annas-archive.is
# ANNAS_ARCHIVE_MIRRORS=https://annas-archive.is,https://annas-archive.gl,https://annas-archive.li,https://annas-archive.org

# Anna's Archive slow downloads now require an account (anti-bot). Register once
# at https://annas-archive.is, copy your session cookie, and set it here to
# enable detail download links + Save-to-depot. Either paste the full "name=value"
# pair, or the bare value (then ANNAS_SESSION_COOKIE_NAME is used, default
# "session"). Leave empty to skip auth (search still works).
# ANNAS_SESSION_COOKIE=
# ANNAS_SESSION_COOKIE_NAME=session